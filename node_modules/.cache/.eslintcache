window.scrollY > 100)\r\n  }) \r\n  return (\r\n    <>\r\n      <header className='header'>\r\n        <div className='scontainer flex'>\r\n          <div className='logo'>\r\n            <img src={logo} alt='logo' width='100px' />\r\n          </div>\r\n          <nav>\r\n            <ul>\r\n              {nav.map((link) => (\r\n                <li key={link.id}>\r\n                  <Link to={link.url}>{link.text}</Link>\r\n                </li>\r\n              ))}\r\n            </ul>\r\n          </nav>\r\n          {/* <div className='account flexCenter'>\r\n            <User />\r\n          </div> */}\r\n        </div>\r\n      </header>\r\n    </>\r\n  )\r\n}\r\n","C:\\Users\\Dell\\Downloads\\Blog-App-MERN-Template-master\\Blog-App-MERN-Template-master\\src\\components\\create\\Create.jsx",["78","79"],[],"import React from \"react\"\r\nimport \"./create.css\"\r\nimport { IoIosAddCircleOutline } from \"react-icons/io\"\r\n\r\nexport const Create = () => {\r\n  return (\r\n    <>\r\n      <section className='newPost'>\r\n        <div className='container boxItems'>\r\n          <div className='img '>\r\n            <img src='https://images.pexels.com/photos/6424244/pexels-photo-6424244.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1' alt='image' class='image-preview' />\r\n          </div>\r\n          <form>\r\n            <div className='inputfile flexCenter'>\r\n              <input type='file' accept='image/*' alt='img' />\r\n            </div>\r\n            <input type='text' placeholder='Title' />\r\n\r\n            <textarea name='' id='' cols='30' rows='10'></textarea>\r\n\r\n            <button className='button'>Create Post</button>\r\n          </form>\r\n        </div>\r\n      </section>\r\n    </>\r\n  )\r\n}\r\n","C:\\Users\\Dell\\Downloads\\Blog-App-MERN-Template-master\\Blog-App-MERN-Template-master\\src\\pages\\home\\Home.jsx",[],[],"C:\\Users\\Dell\\Downloads\\Blog-App-MERN-Template-master\\Blog-App-MERN-Template-master\\src\\pages\\details\\DetailsPages.jsx",["80","81","82","83"],[],"import React, { useState } from \"react\"\r\nimport \"./details.css\"\r\nimport \"../../components/header/header.css\"\r\nimport img from \"../../assets/images/b5.jpg\"\r\nimport { BsPencilSquare } from \"react-icons/bs\"\r\nimport { AiOutlineDelete } from \"react-icons/ai\"\r\nimport { useParams } from \"react-router-dom\"\r\nimport { useEffect } from \"react\"\r\nimport { blog } from \"../../assets/data/data\"\r\n\r\nexport const DetailsPages = () => {\r\n  const { id } = useParams()\r\n  const [blogs, setBlogs] = useState(null)\r\n\r\n  useEffect(() => {\r\n    let blogs = blog.find((blogs) => blogs.id === parseInt(id))\r\n    if (blogs) {\r\n      setBlogs(blogs)\r\n    }\r\n  }, [])\r\n\r\n  return (\r\n    <>\r\n      {blogs ? (\r\n        <section className='singlePage'>\r\n          <div className='container'>\r\n            <div className='left'>\r\n              <img src={blogs.cover} alt='' />\r\n            </div>\r\n            <div className='right'>\r\n              {/* <div className='buttons'>\r\n                <button className='button'>\r\n                  <BsPencilSquare />\r\n                </button>\r\n                <button className='button'>\r\n                  <AiOutlineDelete />\r\n                </button>\r\n              </div> */}\r\n              <h1>{blogs.title}</h1>\r\n              <p>{blogs.desc}</p>\r\n            </div>\r\n          </div>\r\n        </section>\r\n      ) : null}\r\n    </>\r\n  )\r\n}\r\n","C:\\Users\\Dell\\Downloads\\Blog-App-MERN-Template-master\\Blog-App-MERN-Template-master\\src\\pages\\login\\Login.jsx",[],[],"C:\\Users\\Dell\\Downloads\\Blog-App-MERN-Template-master\\Blog-App-MERN-Template-master\\src\\pages\\login\\Regsiter.jsx",[],[],"C:\\Users\\Dell\\Downloads\\Blog-App-MERN-Template-master\\Blog-App-MERN-Template-master\\src\\pages\\account\\Account.jsx",["84"],[],"import React from \"react\"\r\nimport image from \"../../assets/images/input.png\"\r\nimport \"./account.css\"\r\n\r\nexport const Account = () => {\r\n  return (\r\n    <>\r\n      <section className='accountInfo'>\r\n        <div className='container boxItems'>\r\n          <h1>Account Information</h1>\r\n          <div className='content'>\r\n            <div className='left'>\r\n              <div className='img flexCenter'>\r\n                <input type='file' accept='image/*' src={image} alt='img' />\r\n                <img src={image} alt='image' class='image-preview' />\r\n              </div>\r\n            </div>\r\n            <div className='right'>\r\n              <label htmlFor=''>Username</label>\r\n              <input type='text' />\r\n              <label htmlFor=''>Email</label>\r\n              <input type='email' />\r\n              <label htmlFor=''>Password</label>\r\n              <input type='password' />\r\n              <button className='button'>Update</button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </section>\r\n    </>\r\n  )\r\n}\r\n","C:\\Users\\Dell\\Downloads\\Blog-App-MERN-Template-master\\Blog-App-MERN-Template-master\\src\\assets\\data\\data.js",[],[],"C:\\Users\\Dell\\Downloads\\Blog-App-MERN-Template-master\\Blog-App-MERN-Template-master\\src\\components\\header\\User.jsx",[],[],"C:\\Users\\Dell\\Downloads\\Blog-App-MERN-Template-master\\Blog-App-MERN-Template-master\\src\\components\\blog\\Card.jsx",["85","86","87"],[],"import React from \"react\"\r\nimport \"./blog.css\"\r\nimport { blog } from \"../../assets/data/data\"\r\nimport { AiOutlineTags, AiOutlineClockCircle, AiOutlineComment, AiOutlineShareAlt } from \"react-icons/ai\"\r\nimport { Link } from \"react-router-dom\"\r\n\r\nexport const Card = () => {\r\n  return (\r\n    <>\r\n      <section className='blog'>\r\n        <div className='container grid3'>\r\n          {blog.map((item) => (\r\n            <div className='box boxItems' key={item.id}>\r\n              <div className='img'>\r\n                <img src={item.cover} alt='' />\r\n              </div>\r\n              <div className='details'>\r\n                <div className='tag'>\r\n                  <AiOutlineTags className='icon' />\r\n                  <a href='/'>#{item.category}</a>\r\n                </div>\r\n                <Link to={`/details/${item.id}`} className='link'>\r\n                  <h3>{item.title}</h3>\r\n                </Link>\r\n                <p>{item.desc.slice(0, 180)}...</p>\r\n                {/* <div className='date'>\r\n                  <AiOutlineClockCircle className='icon' /> <label htmlFor=''>{item.date}</label>\r\n                  <AiOutlineComment className='icon' /> <label htmlFor=''>27</label>\r\n                  <AiOutlineShareAlt className='icon' /> <label htmlFor=''>SHARE</label>\r\n                </div> */}\r\n              </div>\r\n            </div>\r\n          ))}\r\n        </div>\r\n      </section>\r\n    </>\r\n  )\r\n}\r\n","C:\\Users\\Dell\\Downloads\\Blog-App-MERN-Template-master\\Blog-App-MERN-Template-master\\src\\components\\category\\Category.jsx",[],[],{"ruleId":"88","severity":1,"message":"89","line":4,"column":10,"nodeType":"90","messageId":"91","endLine":4,"endColumn":14},{"ruleId":"88","severity":1,"message":"92","line":3,"column":10,"nodeType":"90","messageId":"91","endLine":3,"endColumn":31},{"ruleId":"93","severity":1,"message":"94","line":11,"column":13,"nodeType":"95","endLine":11,"endColumn":172},{"ruleId":"88","severity":1,"message":"96","line":4,"column":8,"nodeType":"90","messageId":"91","endLine":4,"endColumn":11},{"ruleId":"88","severity":1,"message":"97","line":5,"column":10,"nodeType":"90","messageId":"91","endLine":5,"endColumn":24},{"ruleId":"88","severity":1,"message":"98","line":6,"column":10,"nodeType":"90","messageId":"91","endLine":6,"endColumn":25},{"ruleId":"99","severity":1,"message":"100","line":20,"column":6,"nodeType":"101","endLine":20,"endColumn":8,"suggestions":"102"},{"ruleId":"93","severity":1,"message":"94","line":15,"c